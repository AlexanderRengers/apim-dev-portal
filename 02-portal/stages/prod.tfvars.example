# Copy to <stage>.tfvars (e.g. prod.tfvars) and use with: make up-2 STAGE=prod
# Describes an EXISTING APIM instance. All three values are required, because they override
# 02-portal/stage1.auto.tfvars (the dev instance from 'make up-1').
resource_group_name  = "rg-apim-prod"
apim_name            = "apim-prod-example"
developer_portal_url = "https://apim-prod-example.developer.azure-api.net"

# Optional: if prod lives in another subscription or tenant, override them here too.
# subscription_id = "00000000-0000-0000-0000-000000000000"
# tenant_id       = "00000000-0000-0000-0000-000000000000"
