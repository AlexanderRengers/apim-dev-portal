<!-- API-Ebene: gilt für alle Operationen der Customers API.
     Platzhalter (templatefile): portal_origin, table_endpoint. -->
<policies>
    <inbound>
        <!-- CORS zuerst, damit auch der OPTIONS-Preflight aus der Portal-Test-Konsole beantwortet wird. -->
        <cors allow-credentials="false">
            <allowed-origins>
                <origin>${portal_origin}</origin>
            </allowed-origins>
            <allowed-methods>
                <method>GET</method>
                <method>POST</method>
                <method>PUT</method>
                <method>DELETE</method>
            </allowed-methods>
            <!-- Alle Header: Die Test-Konsole schickt je nach Einstellung auch Ocp-Apim-Trace, Cache-Control usw.
                 Eine feste Liste lässt den Preflight dann ohne CORS-Header durchfallen. Mit allow-credentials=false erlaubt. -->
            <allowed-headers>
                <header>*</header>
            </allowed-headers>
            <expose-headers>
                <header>*</header>
            </expose-headers>
        </cors>
        <base />
        <!-- id muss zum Muster aus der OpenAPI-Datei passen. Verhindert OData-Injection über Hochkommas oder Klammern. -->
        <validate-parameters specified-parameter-action="prevent" unspecified-parameter-action="ignore" errors-variable-name="paramErrors" />
        <!-- Der Subscription Key gehört nur zu APIM. Storage soll ihn weder als Header noch als Query-Parameter sehen. -->
        <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
        <set-query-parameter name="subscription-key" exists-action="delete" />
        <!-- Token der System Managed Identity für Table Storage (Rolle Storage Table Data Contributor). -->
        <authentication-managed-identity resource="https://storage.azure.com/" />
        <set-header name="x-ms-version" exists-action="override">
            <value>2019-02-02</value>
        </set-header>
        <set-header name="x-ms-date" exists-action="override">
            <value>@(DateTime.UtcNow.ToString("R"))</value>
        </set-header>
        <set-header name="Accept" exists-action="override">
            <value>application/json;odata=nometadata</value>
        </set-header>
        <set-header name="DataServiceVersion" exists-action="override">
            <value>3.0</value>
        </set-header>
        <set-header name="MaxDataServiceVersion" exists-action="override">
            <value>3.0;NetFx</value>
        </set-header>
        <set-backend-service base-url="${table_endpoint}" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
