<!-- API scope: applies to all operations of the Customers API.
     Placeholders (templatefile): portal_origin, table_endpoint. -->
<policies>
    <inbound>
        <!-- CORS first, so the OPTIONS preflight from the portal test console is answered too. -->
        <cors allow-credentials="false">
            <allowed-origins>
                <origin>${portal_origin}</origin>
            </allowed-origins>
            <allowed-methods>
                <method>GET</method>
                <method>POST</method>
                <method>PUT</method>
                <method>DELETE</method>
            </allowed-methods>
            <!-- All headers: depending on its settings the test console also sends Ocp-Apim-Trace, Cache-Control etc.
                 A fixed list makes the preflight fail without CORS headers. Allowed with allow-credentials=false. -->
            <allowed-headers>
                <header>*</header>
            </allowed-headers>
            <expose-headers>
                <header>*</header>
            </expose-headers>
        </cors>
        <base />
        <!-- id must match the pattern from the OpenAPI file. Prevents OData injection via quotes or parentheses. -->
        <validate-parameters specified-parameter-action="prevent" unspecified-parameter-action="ignore" errors-variable-name="paramErrors" />
        <!-- The subscription key belongs to APIM only. Storage must see it neither as header nor as query parameter. -->
        <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
        <set-query-parameter name="subscription-key" exists-action="delete" />
        <!-- System managed identity token for Table Storage (role Storage Table Data Contributor). -->
        <authentication-managed-identity resource="https://storage.azure.com/" />
        <set-header name="x-ms-version" exists-action="override">
            <value>2019-02-02</value>
        </set-header>
        <set-header name="x-ms-date" exists-action="override">
            <value>@(DateTime.UtcNow.ToString("R"))</value>
        </set-header>
        <set-header name="Accept" exists-action="override">
            <value>application/json;odata=nometadata</value>
        </set-header>
        <set-header name="DataServiceVersion" exists-action="override">
            <value>3.0</value>
        </set-header>
        <set-header name="MaxDataServiceVersion" exists-action="override">
            <value>3.0;NetFx</value>
        </set-header>
        <set-backend-service base-url="${table_endpoint}" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
