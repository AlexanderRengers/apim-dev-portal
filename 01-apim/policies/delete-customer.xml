<policies>
    <inbound>
        <base />
        <!-- If-Match: * is mandatory for delete. An unknown id then returns 404. -->
        <set-header name="If-Match" exists-action="override">
            <value>*</value>
        </set-header>
        <rewrite-uri template="/customers(PartitionKey='customer',RowKey='{id}')" copy-unmatched-params="false" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
